<record id="view_salt_edge_demo_tree" model="ir.ui.view">
    <field name="name">salt.edge.demo.tree</field>
    <field name="model">salt.edge.demo</field>
    <field name="arch" type="xml">
        <tree>
            <field name="name"/>
        </tree>
    </field>
</record>

<record id="view_salt_edge_demo_form" model="ir.ui.view">
    <field name="name">salt.edge.demo.form</field>
    <field name="model">salt.edge.demo</field>
    <field name="arch" type="xml">
        <form string="Salt Edge Demo">
            <group>
                <field name="name"/>
            </group>
            <footer>
                <button name="action_connect_sandbox" type="object"
                        class="btn-primary" string="Simulate Connection"/>
            </footer>
        </form>
    </field>
</record>

<record id="action_salt_edge_demo" model="ir.actions.act_window">
    <field name="name">Demo Connection</field>
    <field name="res_model">salt.edge.demo</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem id="menu_salt_edge_demo_item"
          name="Demo Connection"
          parent="menu_salt_edge_demo_root"
          action="action_salt_edge_demo"
          sequence="2"/>
