<odoo>
  <template id="portal_my_orders_add_status" inherit_id="sale.portal_my_orders">
    
    <!-- Add new table header -->
    <xpath expr="//thead/tr" position="inside">
      <th class="text-end">Status</th>
    </xpath>

    <!-- Add new status cell per row -->
    <xpath expr="//t[@t-foreach='orders']/tr" position="inside">
      <td class="text-end">
        <t t-if="order.state in ['sale', 'done']">
          <span class="badge bg-success">Confirmed</span>
        </t>
        <t t-elif="order.state in ['draft', 'sent']">
          <span class="badge bg-warning text-dark">Placed</span>
        </t>
        <t t-else="">
          <span class="badge bg-secondary">Other</span>
        </t>
      </td>
    </xpath>

  </template>
</odoo>
