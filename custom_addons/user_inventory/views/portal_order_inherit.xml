<odoo>
  <template id="user_inventory_sync_button_inline" inherit_id="sale.sale_order_portal_content">
    
    <xpath expr="//div[@id='intro_row']/h2" position="replace">
      <div class="d-flex justify-content-between align-items-center flex-wrap w-100">
        <h2 class="m-0">
          <t t-out="sale_order.name"/>
        </h2>
        
        <t t-if="sale_order.state in ['sale', 'done']">
          <a t-attf-href="/my/order/{{ sale_order.id }}/sync_inventory"
             class="btn btn-outline-primary mt-2 mt-sm-0">
            Update Inventory with This Order
          </a>
        </t>
      </div>
    </xpath>
  </template>
</odoo>
