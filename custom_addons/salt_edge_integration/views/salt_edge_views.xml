<odoo>
  <record id="view_salt_edge_settings_form" model="ir.ui.view">
    <field name="name">salt.edge.settings.form</field>
    <field name="model">salt.edge.settings</field>
    <field name="arch" type="xml">
      <form string="Salt Edge Configuration">
        <sheet>
          <group>
            <field name="app_id"/>
            <field name="secret"/>
          </group>
          <footer>
            <button name="connect_to_salt_edge" string="Test Connection" type="object" class="btn-primary"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_salt_edge_settings" model="ir.actions.act_window">
    <field name="name">Salt Edge Settings</field>
    <field name="res_model">salt.edge.settings</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="view_id" ref="view_salt_edge_settings_form"/>
  </record>

  <menuitem id="menu_salt_edge_root" name="Salt Edge" sequence="100"/>
  <menuitem id="menu_salt_edge_config" name="Configuration" parent="menu_salt_edge_root" action="action_salt_edge_settings" sequence="10"/>
</odoo>