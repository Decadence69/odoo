<odoo>
  <template id="portal_inventory_template" name="User Inventory Page">
    <t t-call="website.layout">
      <div class="container my-5">
        <h2 class="mb-4">My Inventory</h2>

        <!-- Custom Add Existing Form -->
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="card-title">Add Product from Catalog</h5>
            <form t-att-action="url_for('/my/inventory/add_existing')" method="post" class="mb-4">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />

              <div class="row">
                <div class="col-md-6 mb-2">
                  <input name="product_search" list="product_list" class="form-control" placeholder="Search for a product..." required="required"/>
                  <datalist id="product_list">
                    <t t-foreach="product_options" t-as="product">
                      <option t-att-value="product.display_name"/>
                    </t>
                  </datalist>
                </div>
                <div class="col-md-3 mb-2">
                  <input type="number" name="custom_qty" class="form-control" placeholder="Quantity" min="0" required="required"/>
                </div>
                <div class="col-md-3 mb-2">
                  <button type="submit" class="btn btn-primary w-100">Add Product</button>
                </div>
              </div>
            </form>

          </div>
        </div>

        <!-- Custom Add Custom Form -->
        <form t-att-action="url_for('/my/inventory/add_custom')" method="post">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <button type="button" class="btn btn-success mb-3" data-bs-toggle="collapse" data-bs-target="#customInventoryForm">
          + Add Custom Inventory Record
          </button>
          <div id="customInventoryForm" class="collapse mb-4">
            <div class="row">
              <div class="col-md-6 mb-2">
                <input type="text" name="custom_product_name" class="form-control" placeholder="Product Name" required="required"/>
              </div>
              <div class="col-md-3 mb-2">
                <input type="number" name="custom_qty" class="form-control" placeholder="Quantity" min="0" required="required"/>
              </div>
              <div class="col-md-3 mb-2">
                <button type="submit" class="btn btn-primary w-100">Add Record</button>
              </div>
            </div>
          </div>
        </form>

        <!-- Main Inventory Update Form -->
        <form id="form_update" t-att-action="url_for('/my/inventory/update')" method="post">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

          <table class="table table-striped align-middle">
            <thead>
              <tr>
                <th>Product</th>
                <th>Total Ordered</th>
                <th>Target Stock</th>
                <th>Current Stock</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="inventory" t-as="line">
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <t t-if="line.is_custom">
                        <span class="fw-bold">
                          <t t-esc="line.custom_name"/>
                        </span>
                      </t>
                      <t t-if="not line.is_custom">
                        <img t-att-src="'/web/image/product.product/%s/image_128' % line.product_id.id" class="rounded me-2" style="width: 48px; height: 48px;" />
                        <a t-attf-href="/shop/product/{{ line.product_id.id }}">
                          <t t-esc="line.product_id.display_name"/>
                        </a>
                      </t>
                    </div>
                  </td>
                  <td>
                    <t t-esc="line.total_ordered_qty if not line.is_custom else '–'"/>
                  </td>
                  <td>
                    <input type="number" class="form-control" t-att-name="'target_{}'.format(line.id)" t-att-value="str(line.target_qty or 0)" min="0"/>
                  </td>
                  <td>
                    <input type="number" class="form-control" t-att-name="'qty_{}'.format(line.id)" t-att-value="str(line.current_qty or 0)" min="0"/>
                  </td>
                  <td>
                    <t t-if="not line.is_custom">
                      <form t-attf-id="reorder-form-#{line.id}" action="/my/inventory/reorder" method="post" style="display: none;">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="line_id" t-att-value="line.id"/>
                      </form>
                      <button type="button" class="btn btn-primary w-100 js-reorder-btn" style="min-width: 10rem" t-att-disabled="line.current_qty >= line.target_qty and 'disabled' or None" t-attf-data-line-id="{{ line.id }}">
                        Reorder
                      </button>
                    </t>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
          <div class="d-flex align-items-center gap-2 mt-3">
            <button type="submit" 
                    form="form_update"
                    class="btn btn-primary">
              Save Inventory
            </button>

            <form t-att-action="url_for('/my/inventory/reorder_all')"
                  method="post"
                  class="m-0">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <button type="submit"
                      class="btn btn-warning js-reorder-all-btn"
                      t-att-disabled="not needs_reorder and 'disabled' or None">
                Reorder All
              </button>
            </form>
          </div>

        </form>
      </div>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('.js-reorder-btn').forEach(function(btn) {
            btn.addEventListener('click', function (ev) {
              ev.preventDefault();

              var lineId = btn.getAttribute('data-line-id');
              var form   = document.getElementById('reorder-form-' + lineId);
              var token  = form.querySelector('[name="csrf_token"]').value;

              // 1) Disable &amp; show spinner
              btn.disabled = true;
              btn.innerHTML = 
                '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ' +
                'Reordering…';

              // 2) AJAX POST
              fetch(form.action, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                  'Content-Type': 'application/x-www-form-urlencoded',
                  'X-CSRFToken': token,
                },
                body: new URLSearchParams(new FormData(form))
              })
              .then(function(response) {
                if (!response.ok) { throw new Error('Network error'); }
                return response.text();
              })
              .then(function() {
                // 3) Swap in the checkmark
                btn.innerHTML = '✔ Added to cart';
              })
              .catch(function() {
                btn.innerHTML = '⚠️ Failed';
                btn.disabled = false;
              });
            });
          });
          var allBtn = document.querySelector('.js-reorder-all-btn');
          if (allBtn) {
            allBtn.addEventListener('click', function(ev) {
              ev.preventDefault();
              // disable &amp; show spinner
              this.disabled = true;
              this.innerHTML = 
                '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ' +
                'Reordering…';
              // submit the form normally
              this.closest('form').submit();
            });
          }
        });
      </script>
    </t>
  </template>
</odoo>
