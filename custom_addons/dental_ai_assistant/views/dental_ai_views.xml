<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Assistant Widget View -->
    <record id="view_dental_ai_widget" model="ir.ui.view">
        <field name="name">dental.ai.widget</field>
        <field name="model">dental.ai.assistant</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Ask Dental AI">
                <div class="dental-ai-widget">
                    <div class="o_row">
                        <div class="o_cell o_wrap_input flex-grow-1 flex-sm-grow-0 text-break">
                            <field name="query"
                                   placeholder="Ask about dental procedures, burs, or tools..."
                                   class="o_field_char o_field_widget o_input"
                                   style="min-width: 400px;"/>
                        </div>
                        <button name="get_ai_recommendation"
                                string="Get Recommendation"
                                type="object"
                                class="btn btn-primary ml-2"/>
                    </div>
                    <div id="ai-response" class="mt-3" style="display: none;">
                        <div class="alert alert-info" role="alert">
                            <div id="ai-recommendation-content"/>
                            <div class="mt-2">
                                <small class="text-muted">
                                    <strong>Sources:</strong> <span id="ai-sources"/>
                                </small>
                            </div>
                        </div>
                    </div>
                    <div id="ai-loading" class="text-center mt-3" style="display: none;">
                        <i class="fa fa-spinner fa-spin"/> Getting AI recommendation...
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_dental_ai_assistant" model="ir.actions.act_window">
        <field name="name">AI Recommendations</field>
        <field name="res_model">dental.ai.assistant</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_recommendations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI recommendations yet!
            </p>
            <p>
                Start by asking the AI assistant about dental procedures, burs, or tools.
            </p>
        </field>
    </record>

    <record id="action_dental_ai_widget" model="ir.actions.act_window">
        <field name="name">Ask Dental AI</field>
        <field name="res_model">dental.ai.assistant</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_dental_ai_widget"/>
        <field name="target">new</field>
    </record>

    <record id="action_dental_ai_config" model="ir.actions.act_window">
        <field name="name">Dental AI Configuration</field>
        <field name="res_model">dental.ai.config</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_dental_ai_root" name="Dental AI Assistant" sequence="10"/>
    <menuitem id="menu_dental_ai_recommendations"
              name="Recommendations"
              parent="menu_dental_ai_root"
              action="action_dental_ai_assistant"
              sequence="10"/>
    <menuitem id="menu_dental_ai_config"
              name="Configuration"
              parent="menu_dental_ai_root"
              action="action_dental_ai_config"
              sequence="20"/>

    <!-- Dental AI Assistant Views -->
    <record id="view_dental_ai_assistant_form" model="ir.ui.view">
        <field name="name">dental.ai.assistant.form</field>
        <field name="model">dental.ai.assistant</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Dental AI Recommendation">
                <header>
                    <button name="action_regenerate_recommendation"
                            string="Regenerate"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="query" placeholder="e.g., What burs do I need for zirconia crown removal?"/>
                            <field name="created_by" readonly="1"/>
                            <field name="date_created" readonly="1"/>
                        </group>
                        <group>
                            <field name="sources" readonly="1"/>
                            <field name="confidence_score" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="AI Recommendation">
                            <field name="recommendation" readonly="1" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_ai_assistant_tree" model="ir.ui.view">
        <field name="name">dental.ai.assistant.tree</field>
        <field name="model">dental.ai.assistant</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="AI Recommendations">
                <field name="date_created"/>
                <field name="query"/>
                <field name="created_by"/>
                <field name="confidence_score"/>
                <field name="sources"/>
            </list>
        </field>
    </record>

    <record id="view_dental_ai_assistant_search" model="ir.ui.view">
        <field name="name">dental.ai.assistant.search</field>
        <field name="model">dental.ai.assistant</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Search Recommendations">
                <field name="query"/>
                <field name="created_by"/>
                <field name="sources"/>
                <filter string="My Recommendations" name="my_recommendations" domain="[('created_by', '=', uid)]"/>
                <filter string="This Week" name="this_week" domain="[('date_created', '>=', (context_today() - 7))]"/>
                <group expand="0" string="Group By">
                    <filter string="Created By" name="group_by_user" context="{'group_by': 'created_by'}"/>
                    <filter string="Date Created" name="group_by_date" context="{'group_by': 'date_created:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Configuration View -->
    <record id="view_dental_ai_config_form" model="ir.ui.view">
        <field name="name">dental.ai.config.form</field>
        <field name="model">dental.ai.config</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Dental AI Configuration">
                <header>
                    <button name="action_test_connection"
                            string="Test API Connection"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_build_knowledge_base"
                            string="Build Knowledge Base"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="gemini_api_key"/>
                                <div class="text-muted">
                                    Your Google Gemini API key for AI recommendations
                                </div>
                                <field name="gemini_api_key" password="True" class="o_light_label"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="knowledge_base_path"/>
                                <div class="text-muted">
                                    Path where the knowledge base will be stored
                                </div>
                                <field name="knowledge_base_path" class="o_light_label"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="jsonl_file_path"/>
                                <div class="text-muted">
                                    Path to your JSONL blog file for building knowledge base
                                </div>
                                <field name="jsonl_file_path" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>