<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Category Grid Page Template -->
    <template id="category_grid_page" name="Category Grid Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_category_grid pt-5 pb-5">
                    <div class="container">
                        <div class="row mb-4">
                            <div class="col-lg-12">
                                <h1 class="text-center mb-3">Shop by Category</h1>
                                <p class="text-center text-muted">Browse our product categories</p>
                            </div>
                        </div>
                        
                        <div class="row g-3">
                            <!-- All Products Card -->
                            <div class="col-6 col-md-4 col-lg-3">
                                <a href="/shop" class="text-decoration-none">
                                    <div class="card h-100 category-card shadow-sm">
                                        <img src="/category_grid/static/src/img/all_products.jpg" 
                                             class="card-img-top category-img" 
                                             alt="All Products"
                                             loading="lazy"/>
                                        <div class="card-body text-center">
                                            <h5 class="card-title mb-1">ALL PRODUCTS</h5>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            
                            <!-- Category Cards -->
                            <t t-foreach="category_data" t-as="cat_item">
                                <t t-set="category" t-value="cat_item['category']"/>
                                <div class="col-6 col-md-4 col-lg-3">
                                    <a t-att-href="cat_item['url']" class="text-decoration-none">
                                        <div class="card h-100 category-card shadow-sm">
                                            <t t-if="category.image_128">
                                                <img t-att-src="'/web/image/product.public.category/%s/image_1024' % category.id" 
                                                     class="card-img-top category-img" 
                                                     t-att-alt="category.name"
                                                     loading="lazy"/>
                                            </t>
                                            <t t-else="">
                                                <div class="card-img-top category-img-placeholder d-flex align-items-center justify-content-center bg-light">
                                                    <i class="fa fa-folder-open fa-3x text-muted"></i>
                                                </div>
                                            </t>
                                            <div class="card-body text-center">
                                                <h5 class="card-title mb-1" t-esc="category.name"/>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                        
                        <!-- Empty state if no categories -->
                        <t t-if="not category_data">
                            <div class="row">
                                <div class="col-12 text-center py-5">
                                    <i class="fa fa-folder-open fa-4x text-muted mb-3"></i>
                                    <h3 class="text-muted">No categories available</h3>
                                    <p class="text-muted">Categories will appear here once they are created.</p>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>