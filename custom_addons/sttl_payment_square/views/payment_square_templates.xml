<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="redirect_form">
        <form t-att-action="tx_url" method="get">
            <input type="hidden" name="reference" t-att-value="reference"/>
            <p>You will be redirected to the Square payment page.</p>
        </form>
    </template>
    
    <template id="iframe_safe_redirect">
        <html>
            <head>
                <script>
                    if (window !== window.top) {
                        window.top.location.href = "<t t-esc="redirect_url"/>";
                    } else {
                        window.location.href = "<t t-esc="redirect_url"/>";
                    }
                </script>
            </head>
            <body>
                <p>Redirecting to payment status page...</p>
                <p>If you are not redirected automatically, <a t-att-href="redirect_url">click here</a>.</p>
            </body>
        </html>
    </template>
</odoo>